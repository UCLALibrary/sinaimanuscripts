<footer class='site-footer site-footer--sinai'>
  <div class='container-full site-footer__primary site-footer__primary--sinai'>
    <div class='site-footer__primary-wrapper--sinai'>
      <p class='site-footer__title--sinai'>Sponsors</p>

      <div class='site-footer__logos--sinai'>
        <div class="site-footer__logo-wrapper--sinai">
          <%= image_tag('sinai-logos/logo-sinai-wht-hz.png', class: 'site-footer__logo--sinai site-footer__logo--sinai-lead', alt: 'St Catherine Monastery logo') %>
        </div>
        <div class="site-footer__logo-wrapper--sinai">
          <%= image_tag('sinai-logos/logo-uclalib-wht.svg', class: 'site-footer__logo--sinai site-footer__logo--sinai-ucla', alt: 'UCLA Library logo') %>
        </div>
        <div class="site-footer__logo-wrapper--sinai">
          <%= image_tag('sinai-logos/logo-arcadia-wht.svg', class: 'site-footer__logo--sinai site-footer__logo--sinai-arcadia', alt: 'Arcadia logo') %>
        </div>
        <div class="site-footer__logo-wrapper--sinai">
          <%= image_tag('sinai-logos/logo-ahmanson-wht.png', class: 'site-footer__logo--sinai site-footer__logo--sinai-ahmanson', alt: 'Ahmanson Foundation logo') %>
        </div>
        <div class="site-footer__logo-wrapper--sinai">
          <%= image_tag('sinai-logos/logo-emel-wht-txt.png', class: 'site-footer__logo--sinai site-footer__logo--sinai-emel', alt: 'EMEL logo') %>
        </div>
        <div class="site-footer__logo-wrapper--sinai">
          <%= image_tag('sinai-logos/logo-neh-wht.png', class: 'site-footer__logo--sinai site-footer__logo--sinai-neh', alt: 'National Endowment for the Humanities logo') %>
        </div>
      </div>
    </div>
  </div>
</footer>
