<% if can?(:read, document) %>
<%# Mobile-only notice — the manuscript viewer is best used on a larger screen.
    Hidden on desktop; shown ≤767px via _si-viewer.scss. %>
<div class="media-viewer-mobile-notice--sinai" role="note">
  For the best viewing experience, please open this site on a desktop or laptop computer.
</div>
<%# --------- Sinai Not Logged in ----- %>
  <% if !cookies[:sinai_authenticated_1year] %>
    <%
      cookies[:requested_path] = request.original_url
      login_service = LoginService.new
      @token = login_service.create_token
    %>
    <div class='si-media-viewer-login'>
      <div class="si-auth-text">Login required to view manuscript images.</div>
        <div class="si-auth-modal-btn-group">
          <%= button_to 'Login', ENV['SINAIID_URL'], params: { 'key' => ENV['SINAIID_UCLA_KEY'], callback_url: request.original_url, token: @token }, method: :post, class: 'btn-base btn-outline-sinai--primary  btn-modal' %>
          <%= link_to 'Register', 'https://sinai-id.org/users/sign_up', class: 'btn-base btn-outline-sinai--primary btn-modal' %>
      </div>
    </div>
  <% else %>
  <%# --------- Sinai Logged in ----- %>
    <%# Backdrop shown only while the viewer is promoted to the Examine popup.
        Clicking it closes the popup. Inert/invisible otherwise. %>
    <div class='media-viewer-backdrop--sinai' data-examine-close hidden></div>
    <div class='media-viewer-container media-viewer-container--sinai'>
      <% iiif_service = IiifService.new %>
      <%# Popup chrome — only visible when the container has the promoted class.
          Kept as a sibling of the iframe so the iframe is never reparented
          (which would reload it and drop the viewer's state). %>
      <div class='media-viewer-popup-header--sinai'>
        <span class='media-viewer-popup-title--sinai'><%= document[:shelfmark_ssi] %></span>
        <button type="button"
                class="close media-viewer-popup-close--sinai"
                data-examine-close
                aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <iframe
        class='media-viewer-iframe'
        src="<%= iiif_service.src(request, document) %>"
        width='924px'
        height='668px'
        id='media-viewer-iframe'
        allowfullscreen
        frameborder='0'>
      </iframe>
      </div>
  <% end %>
<% end %>
