<% doc_presenter = show_presenter(document) %>
<% overview = Sinai::OverviewMetadataPresenter.new(document: doc_presenter).overview_terms %>

<% if overview.length > 0 %>
  <dl class="overview-dl--sinai">
    <% overview.each do |field_name, field| %>
      <%# Skip fields that are merged into other rows %>
      <% next if field_name == 'collection_ssim' %>
      <% next if field_name == 'ot_date_tesim' %>
      <% next if field_name == 'format_extent_tesim' && overview['extent_tesi'] %>

      <div class="overview-dl__row--sinai">
        <dt class="overview-dl__label--sinai">
          <% if field_name == 'repository_ssim' %>
            Location
          <% elsif field_name == 'place_of_origin_tesim' %>
            Origin
          <% elsif field_name == 'extent_tesi' || field_name == 'format_extent_tesim' %>
            Extent
          <% else %>
            <%= (render_document_show_field_label document, field: field_name).tr(':', '') %>
          <% end %>
        </dt>
        <dd class="overview-dl__value--sinai">
          <%= doc_presenter.field_value field %>
          <%# Append collection to repository for Location row %>
          <% if field_name == 'repository_ssim' && overview['collection_ssim'] %>
            , <%= doc_presenter.field_value overview['collection_ssim'] %>
          <% end %>
          <%# Append date to place for Origin row %>
          <% if field_name == 'place_of_origin_tesim' && overview['ot_date_tesim'] %>
            <br><%= doc_presenter.field_value overview['ot_date_tesim'] %>
          <% end %>
        </dd>
      </div>

      <%# If there's no place_of_origin but there IS a date, render Origin from date alone %>
      <% if field_name == 'place_of_origin_tesim' %>
        <%# Already handled above %>
      <% end %>
    <% end %>

    <%# Render Origin from date alone if place_of_origin is missing %>
    <% if !overview['place_of_origin_tesim'] && overview['ot_date_tesim'] %>
      <div class="overview-dl__row--sinai">
        <dt class="overview-dl__label--sinai">Origin</dt>
        <dd class="overview-dl__value--sinai">
          <%= doc_presenter.field_value overview['ot_date_tesim'] %>
        </dd>
      </div>
    <% end %>
  </dl>
<% end %>
