<%# === Undertexts Tab === %>
<%# Lists Undertext Objects (UTOs) grouped by part, plus a trailing %>
<%# "In flyleaves, bindings, repairs" group for ms_obj-level UTOs %>
<%# not tied to any part. %>

<% ms_json_ut = begin JSON.parse(document['manuscript_json_ts'] || '{}') rescue {} end %>
<% parts_ut = Array(ms_json_ut['part']) %>

<%
  part_groups = parts_ut.each_with_index.map { |p, i|
    utos = Array(p['uto'])
    next nil if utos.empty?
    { label: p['label'].to_s.presence || "Part #{i + 1}", utos: utos, part_idx: i }
  }.compact

  # Root-level (ms_obj) UTOs and Part-level UTOs are distinct layers in the data
  # model and are rendered independently — no cross-level deduplication.
  flyleaf_utos = Array(ms_json_ut['uto'])
%>

<% if part_groups.any? || flyleaf_utos.any? %>
  <div class="undertexts-section--sinai">
    <h2 class="overview-heading--sinai">Undertext Objects</h2>

    <% part_groups.each do |group| %>
      <section class="undertext-group--sinai">
        <h3 class="undertext-group__label--sinai"><%= h(group[:label]) %></h3>
        <% group[:utos].each_with_index do |uto, ui| %>
          <%= render 'catalog/work_record--sinai/undertext_entry',
                     uto: uto,
                     data_path: "ms_obj.part[#{group[:part_idx]}].uto[#{ui}]" %>
        <% end %>
      </section>
    <% end %>

    <% if flyleaf_utos.any? %>
      <section class="undertext-group--sinai">
        <h3 class="undertext-group__label--sinai">In flyleaves, bindings, repairs</h3>
        <% flyleaf_utos.each_with_index do |uto, ui| %>
          <%= render 'catalog/work_record--sinai/undertext_entry',
                     uto: uto,
                     data_path: "ms_obj.uto[#{ui}]" %>
        <% end %>
      </section>
    <% end %>
  </div>
<% end %>
