<% doc_presenter = show_presenter(document) %>
<% keyword = Sinai::KeywordsMetadataPresenter.new(document: doc_presenter).keywords_terms %>

<% if keyword.length > 0 %>
  <div class="overview-dl__row--sinai overview-dl__row-keywords--sinai">
    <dt class="overview-dl__label--sinai">Keywords</dt>
    <dd class="overview-dl__value--sinai overview-dl__value-keywords--sinai">
      <% keyword.each do |field_name, field| %>
        <% raw_values = document[field_name] %>
        <% Array(raw_values).each do |keyword_term| %>
          <span class="keyword-badge--sinai"><%= keyword_term %></span>
        <% end %>
      <% end %>
    </dd>
  </div>
<% end %>
