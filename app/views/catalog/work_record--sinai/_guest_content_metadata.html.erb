<%# === Guest Content tab (NOP-160) === %>
<%# A single top-level "Guest Content" heading, then a list of collapsible guest %>
<%# objects: guest_layer accordions first (via _guest_layer_entry), then guest-typed %>
<%# paracontent and notes that live OUTSIDE any guest layer. No large red headings %>
<%# on the objects themselves — they collapse from their first label line. %>

<% ms_json = begin JSON.parse(document['manuscript_json_ts'] || '{}') rescue {} end %>

<%
  # Collect guest layers in document order: ms_obj root first, then per-part.
  # A guest layer is denormalized to BOTH the ms_obj root and its owning
  # part[].guest_layer[] (same layer_record.ark), so dedupe by ark to render each
  # layer once. Root occurrence wins; ark-less layers are never collapsed.
  guest_layers = []
  seen_layer_arks = []
  add_guest_layer = lambda do |gl, path|
    ark = gl.dig('layer_record', 'ark').to_s
    return if ark.present? && seen_layer_arks.include?(ark)
    seen_layer_arks << ark if ark.present?
    guest_layers << { gl: gl, path: path }
  end
  Array(ms_json['guest_layer']).each_with_index do |gl, i|
    add_guest_layer.call(gl, "ms_obj.guest_layer[#{i}]")
  end
  Array(ms_json['part']).each_with_index do |part, pi|
    Array(part['guest_layer']).each_with_index do |gl, gi|
      add_guest_layer.call(gl, "ms_obj.part[#{pi}].guest_layer[#{gi}]")
    end
  end

  # Guest paracontent OUTSIDE a guest layer: ms_obj.para + part.para where type.id=guest.
  guest_paras = []
  Array(ms_json['para']).each_with_index do |pa, i|
    guest_paras << { pa: pa, path: "ms_obj.para[#{i}]" } if pa.dig('type', 'id') == 'guest'
  end
  Array(ms_json['part']).each_with_index do |part, pi|
    Array(part['para']).each_with_index do |pa, i|
      guest_paras << { pa: pa, path: "ms_obj.part[#{pi}].para[#{i}]" } if pa.dig('type', 'id') == 'guest'
    end
  end

  # Guest notes OUTSIDE a guest layer: ms_obj.note + part.note where type.id=guest.
  guest_notes = []
  Array(ms_json['note']).each { |n| guest_notes << n if n.dig('type', 'id') == 'guest' }
  Array(ms_json['part']).each do |part|
    Array(part['note']).each { |n| guest_notes << n if n.dig('type', 'id') == 'guest' }
  end
%>

<% if guest_layers.any? || guest_paras.any? || guest_notes.any? %>
  <%# data-nav-skip: the section title stays on the page but is not a nav node, so %>
  <%# guest layers (and outside-layer paracontent) become the top-level nav entries. %>
  <h2 id="section-guest-content" class="overview-heading--sinai" data-nav-skip>Guest Content</h2>

  <%# === Guest layers (collapsible accordions) === %>
  <% guest_layers.each_with_index do |entry, layer_i| %>
    <%= render 'catalog/work_record--sinai/guest_layer_entry',
               gl: entry[:gl],
               index: layer_i,
               data_path: entry[:path] %>
  <% end %>

  <%# === Guest paracontent outside a guest layer (collapsible accordions) === %>
  <% if guest_paras.any? %>
    <div class="works-section--sinai works-section--inline--sinai item-subsection--sinai guest-content__outside--sinai">
      <div class="works-section__label--sinai">Paracontents</div>
      <div class="works-section__items--sinai">
        <% guest_paras.each do |entry| %>
          <%# heading_level: :h3 makes each guest paracontent a top-level nav entry, parallel to layers. %>
          <%= render 'catalog/work_record--sinai/para_entry',
                     pa: entry[:pa],
                     data_path: entry[:path],
                     fallback_header: 'Guest Paracontent',
                     heading_level: :h3 %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# === Guest notes outside a guest layer === %>
  <% if guest_notes.any? %>
    <%# Inline like the other guest rows, but the value is plain text (not an %>
    <%# object header pushed down by summary padding), so the --plain modifier %>
    <%# gives its label the plain-value nudge instead of the object-header one. %>
    <div class="works-section--sinai works-section--inline--sinai works-section--inline--plain--sinai item-subsection--sinai guest-content__outside--sinai">
      <div class="works-section__label--sinai">Notes</div>
      <div class="works-section__items--sinai">
        <% guest_notes.each do |n| %>
          <div class="part-grouped-block__line--sinai"><%= h(n['value']) %></div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
