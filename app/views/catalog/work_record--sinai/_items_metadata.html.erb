<%# === Items / Contents Section (top-level only) === %>
<%# Per-part items now render under each Part in _parts_metadata.html.erb. %>
<%# This partial renders text_units at ms_obj level that aren't attached to any part. %>
<% ms_json_items = begin JSON.parse(document['manuscript_json_ts'] || '{}') rescue {} end %>

<%
  orphan_items = []
  Array(ms_json_items['ot_layer']).each_with_index do |ot_layer, layer_idx|
    Array(ot_layer.dig('layer_record', 'text_unit')).each_with_index do |tu, tu_idx|
      orphan_items << {
        layer_idx: layer_idx,
        tu_idx: tu_idx,
        tu: tu
      }
    end
  end
%>

<% if orphan_items.any? %>
  <div class="items-section--sinai">
    <h2 class="overview-heading--sinai">Contents</h2>

    <% orphan_items.each_with_index do |item_data, idx| %>
      <%= render 'catalog/work_record--sinai/item_entry',
                 item_data: item_data,
                 item_num: idx + 1,
                 data_path: "ms_obj.ot_layer[#{item_data[:layer_idx]}].layer_record.text_unit[#{item_data[:tu_idx]}]" %>
    <% end %>
  </div>
<% end %>
