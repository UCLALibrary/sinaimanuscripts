<%# Sticky right-side rail for a tab panel.
    Locals:
      entries  — Array of nav nodes (id, label, children). May be nil/[] for tabs
                 that don't have a server-built outline yet.
      document — current SolrDocument (for Examine-manuscript card visibility) %>
<% entries_local = local_assigns.fetch(:entries, nil) %>
<aside class="right-rail--sinai" data-right-rail aria-label="Manuscript navigation">
  <div class="right-rail__sticky--sinai">
    <% if entries_local.present? %>
      <nav class="right-rail__nav-card--sinai" aria-label="Sections in this tab">
        <div class="right-rail__nav-label--sinai">Navigation</div>
        <%= render 'catalog/work_record--sinai/right_rail_nav_tree',
                   entries: entries_local,
                   depth: 0 %>
      </nav>
    <% end %>

    <% if cookies[:sinai_authenticated_1year] && document[:iiif_manifest_url_ssi].present? %>
      <div class="right-rail__viewer-card--sinai" data-right-rail-viewer hidden>
        <button type="button"
                class="right-rail__viewer-btn--sinai"
                data-toggle="modal"
                data-target="#examine-manuscript-modal">
          <svg class="right-rail__viewer-icon--sinai" width="20" height="14" viewBox="0 0 20 14" aria-hidden="true">
            <path fill="currentColor" d="M10 0C5.5 0 1.7 2.8 0 7c1.7 4.2 5.5 7 10 7s8.3-2.8 10-7c-1.7-4.2-5.5-7-10-7zm0 11.7c-2.6 0-4.7-2.1-4.7-4.7S7.4 2.3 10 2.3 14.7 4.4 14.7 7 12.6 11.7 10 11.7zM10 4.2A2.8 2.8 0 1 0 10 9.8 2.8 2.8 0 0 0 10 4.2z"/>
          </svg>
          <span>Examine manuscript</span>
        </button>
        <p class="right-rail__viewer-hint--sinai">Click to view in a pop-up window</p>
      </div>
    <% end %>
  </div>
</aside>
