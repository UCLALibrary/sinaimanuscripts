<%# Floating viewer triggered from the right-rail Examine-manuscript card.
    The iframe src is set lazily on show.bs.modal and cleared on hide so we
    only spin up a second Mirador instance when the user actually opens it. %>
<% if cookies[:sinai_authenticated_1year] && @document[:iiif_manifest_url_ssi].present? %>
  <% iiif_service = IiifService.new %>
  <div class="modal fade examine-manuscript-modal--sinai"
       id="examine-manuscript-modal"
       tabindex="-1"
       role="dialog"
       aria-labelledby="examine-manuscript-modal-label"
       aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="examine-manuscript-modal-label">
            <%= @document[:shelfmark_ssi] %>
          </h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <iframe
            class="examine-manuscript-modal__iframe--sinai"
            data-examine-manuscript-iframe
            data-iframe-src="<%= iiif_service.src(request, @document) %>"
            allowfullscreen
            frameborder="0"
            title="Manuscript viewer (pop-up)"></iframe>
        </div>
      </div>
    </div>
  </div>
<% end %>
