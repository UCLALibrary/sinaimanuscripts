<% ms_json = begin JSON.parse(document['manuscript_json_ts'] || '{}') rescue {} end %>
<% parts = Array(ms_json['part']) %>

<% parts.each_with_index do |part, part_idx| %>
  <%
    # === Extract part-level data ===
    part_label = part['label'].to_s
    part_locus = part['locus'].to_s
    part_summary = part['summary'].to_s
    part_extent = part['extent'].to_s
    part_dim = part['dim'].to_s
    part_supports = Array(part['support'])
    part_support_notes = Array(part['note']).select { |n| n.dig('type', 'id') == 'support' }
    part_collation_notes = Array(part['note']).select { |n| n.dig('type', 'id') == 'collation' }

    # === Extract ot_layer data (first ot_layer for scribe/writing/ink/layout) ===
    ot_layers = Array(part['ot_layer'])
    first_lr = ot_layers.first&.dig('layer_record') || {}

    # Origin: collect from part, all ot_layer.layer_record, and ot_layer.layer_record.para
    # Filter dates by type.id=origin; places by event.id=origin
    part_origins = []
    part_origins_debug = []
    first_origin_date = nil

    collect_part_origins = ->(dates, places, debug_prefix) {
      origin_dates  = Array(dates).select  { |d| d.dig('type',  'id') == 'origin' }
      origin_places = Array(places).select { |p| p.dig('event', 'id') == 'origin' }

      if origin_dates.any?
        origin_dates.each_with_index do |date, di|
          place      = origin_places[di] || origin_places.first
          date_val   = date['value'].to_s
          place_val  = place ? (place['value'].to_s.presence || place.dig('place_record', 'pref_name').to_s) : ''
          line = if date_val.present? && place_val.present?
                   "#{date_val} ; #{place_val}"
                 else
                   date_val.presence || place_val
                 end
          if line.present?
            part_origins << line
            first_origin_date ||= date_val if date_val.present?
            part_origins_debug << "#{debug_prefix}.assoc_date[#{di}] = #{date.to_json}"
            part_origins_debug << "#{debug_prefix}.assoc_place = #{(place || {}).to_json}" if place
          end
        end
      elsif origin_places.any?
        origin_places.each_with_index do |p, pli|
          val = p['value'].to_s.presence || p.dig('place_record', 'pref_name').to_s
          next if val.blank?
          part_origins << val
          part_origins_debug << "#{debug_prefix}.assoc_place[#{pli}] = #{p.to_json}"
        end
      end
    }

    collect_part_origins.call(part['assoc_date'], part['assoc_place'], "ms_obj.part[#{part_idx}]")

    ot_layers.each_with_index do |ot_layer, layer_idx|
      lr = ot_layer['layer_record'] || {}
      collect_part_origins.call(lr['assoc_date'], lr['assoc_place'],
                                "ms_obj.part[#{part_idx}].ot_layer[#{layer_idx}].layer_record")

      Array(lr['para']).each_with_index do |pa, pai|
        collect_part_origins.call(pa['assoc_date'], pa['assoc_place'],
                                  "ms_obj.part[#{part_idx}].ot_layer[#{layer_idx}].layer_record.para[#{pai}]")
      end
    end

    part_origins = part_origins.uniq

    # Header date: first origin date value for the section header
    header_date = first_origin_date.to_s

    # Scribe / Writing / Ink / Layout are rendered from first_lr by the
    # shared _layer_fields partial (see below).
  %>

  <!-- DATA SOURCE: ms_obj.part[<%= part_idx %>] -->
  <div class="part-section--sinai">
    <%# === Part Header === %>
    <%
      header_parts = [part_label]
      header_parts << "(#{header_date})" if header_date.present?
      header_suffix = part_locus.present? ? ", #{part_locus}" : ""
    %>
    <!-- DATA SOURCE: ms_obj.part[<%= part_idx %>].label = <%= part_label.to_json %>, ms_obj.part[<%= part_idx %>].locus = <%= part_locus.to_json %>, header_date from first origin date in part / ot_layer / para -->
    <h3 id="section-part-<%= part_idx %>" class="part-heading--sinai"><%= header_parts.join(' ') %><%= header_suffix %></h3>

    <%# === Summary === %>
    <% if part_summary.present? %>
      <!-- DATA SOURCE: ms_obj.part[<%= part_idx %>].summary = <%= part_summary.to_json %> -->
      <p class="part-summary--sinai"><%= part_summary %></p>
    <% end %>

    <dl class="overview-dl--sinai">
      <%# === Origin === %>
      <% if part_origins.any? %>
        <!-- DATA SOURCE: <%= part_origins_debug.join(' | ') %> -->
        <div class="overview-dl__row--sinai">
          <dt class="overview-dl__label--sinai">Origin</dt>
          <dd class="overview-dl__value--sinai">
            <%= stacked_metadata_values(part_origins.map { |o| h(o) }, tight: true) %>
          </dd>
        </div>
      <% end %>

      <%# === Extent === %>
      <% extent_parts_arr = [part_extent, part_dim].reject(&:blank?) %>
      <% if extent_parts_arr.any? %>
        <!-- DATA SOURCE: ms_obj.part[<%= part_idx %>].extent = <%= part_extent.to_json %>, ms_obj.part[<%= part_idx %>].dim = <%= part_dim.to_json %> -->
        <div class="overview-dl__row--sinai">
          <dt class="overview-dl__label--sinai">Extent</dt>
          <dd class="overview-dl__value--sinai">
            <%= extent_parts_arr.join(' | ') %>
          </dd>
        </div>
      <% end %>

      <%# === Support (expandable only when notes exist) === %>
      <% if part_supports.any? || part_support_notes.any? %>
        <!-- DATA SOURCE: ms_obj.part[<%= part_idx %>].support = <%= part_supports.to_json %>, ms_obj.part[<%= part_idx %>].note[type.id=support] = <%= part_support_notes.to_json %> -->
        <% support_summary = part_supports.map { |s| s['label'] }.compact.join(', ') %>
        <div class="overview-dl__row--sinai">
          <% if part_support_notes.any? %>
            <details class="part-expandable--sinai">
              <summary class="part-expandable__summary--sinai">
                <dt class="overview-dl__label--sinai part-expandable__label--sinai">Support</dt>
                <dd class="overview-dl__value--sinai">
                  <%= support_summary %>
                </dd>
              </summary>
              <dd class="overview-dl__value--sinai part-expandable__details--sinai">
                <%= stacked_metadata_values(part_support_notes.map { |n| h(n['value']) }) %>
              </dd>
            </details>
          <% else %>
            <dt class="overview-dl__label--sinai">Support</dt>
            <dd class="overview-dl__value--sinai">
              <%= support_summary %>
            </dd>
          <% end %>
        </div>
      <% end %>

      <%# === Collation === %>
      <% if part_collation_notes.any? %>
        <!-- DATA SOURCE: ms_obj.part[<%= part_idx %>].note[type.id=collation] = <%= part_collation_notes.to_json %> -->
        <div class="overview-dl__row--sinai">
          <dt class="overview-dl__label--sinai">Collation</dt>
          <dd class="overview-dl__value--sinai">
            <%= stacked_metadata_values(part_collation_notes.map { |n| h(n['value']) }) %>
          </dd>
        </div>
      <% end %>

      <%# === Scribe / Writing / Ink / Layout (shared with Guest Content tab) === %>
      <%= render 'catalog/work_record--sinai/layer_fields',
                 layer_record: first_lr,
                 data_path: "ms_obj.part[#{part_idx}].ot_layer[0].layer_record" %>
    </dl>

    <%# === Contents (items belonging to this part) === %>
    <%
      part_items = []
      ot_layers.each_with_index do |ot_layer, layer_idx|
        text_units = Array(ot_layer.dig('layer_record', 'text_unit'))
        text_units.each_with_index do |tu, tu_idx|
          part_items << {
            part_idx: part_idx,
            layer_idx: layer_idx,
            tu_idx: tu_idx,
            tu: tu
          }
        end
      end
    %>
    <% if part_items.any? %>
      <div class="items-section--sinai part-items-section--sinai">
        <h4 class="items-subsection-heading--sinai">Contents</h4>
        <% part_items.each_with_index do |item_data, idx| %>
          <%= render 'catalog/work_record--sinai/item_entry',
                     item_data: item_data,
                     item_num: idx + 1,
                     data_path: "ms_obj.part[#{item_data[:part_idx]}].ot_layer[#{item_data[:layer_idx]}].layer_record.text_unit[#{item_data[:tu_idx]}]" %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
