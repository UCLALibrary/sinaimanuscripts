<%
  # `present` controls whether the tab button AND panel render at all.
  # Tabs that still show dummy content keep `present: true`; as each one gets
  # real content, swap in a data-driven check (mirrors the `undertexts` case).
  ms_json_tabs = begin JSON.parse(document['manuscript_json_ts'] || '{}') rescue {} end
  has_undertexts = Array(ms_json_tabs['uto']).any? ||
                   Array(ms_json_tabs['part']).any? { |p| Array(p['uto']).any? }

  related_mss_tabs    = Array(ms_json_tabs['related_mss'])
  has_disjecta_tab    = related_mss_tabs.any? { |r| r.dig('type', 'id') == 'disjecta' }
  has_filiation_tab   = related_mss_tabs.any? { |r| r.dig('type', 'id') == 'filiation' }
  has_recon_from_tab  = Array(ms_json_tabs['reconstructed_from']).any?
  has_included_in_tab = manuscripts_including_in_reconstruction(ms_json_tabs['ark'].to_s).any?
  has_related_manuscripts = has_disjecta_tab || has_filiation_tab ||
                            has_recon_from_tab || has_included_in_tab

  tab_definitions = [
    { id: 'full-description',        label: 'Full Description',          present: true },
    { id: 'contents',                 label: 'Contents',                   present: true },
    { id: 'undertexts',               label: 'Undertexts',                 present: has_undertexts },
    { id: 'guest-content',            label: 'Guest Content',              present: true },
    { id: 'related-manuscripts',      label: 'Related Manuscripts',        present: has_related_manuscripts },
    { id: 'references-bibliography',  label: 'References & Bibliography',  present: true },
    { id: 'names-dates-places',       label: 'Names, Dates, Places',       present: true },
    { id: 'rights-credits',           label: 'Rights & Credits',           present: true }
  ].select { |t| t[:present] }
%>

<nav class="scrollable-tabs--sinai" aria-label="Manuscript details">
  <button class="scrollable-tabs__arrow scrollable-tabs__arrow--left scrollable-tabs__arrow--hidden" aria-hidden="true" type="button">
    <svg width="16" height="16" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
      <path d="M10 3L5 8L10 13" fill="currentColor"/>
    </svg>
  </button>
  <ul class="scrollable-tabs__list" role="tablist">
    <% tab_definitions.each_with_index do |tab, index| %>
      <li role="presentation">
        <button role="tab"
                aria-selected="<%= index == 0 ? 'true' : 'false' %>"
                aria-controls="panel-<%= tab[:id] %>"
                id="tab-<%= tab[:id] %>"
                class="scrollable-tabs__tab<%= ' scrollable-tabs__tab--active' if index == 0 %>"
                type="button">
          <%= tab[:label] %>
        </button>
      </li>
    <% end %>
  </ul>
  <button class="scrollable-tabs__arrow scrollable-tabs__arrow--right scrollable-tabs__arrow--hidden" aria-hidden="true" type="button">
    <svg width="16" height="16" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
      <path d="M6 3L11 8L6 13" fill="currentColor"/>
    </svg>
  </button>
</nav>

<div class="tab-panels--sinai">
  <%# Full Description — content from current Overview sidebar %>
  <div role="tabpanel" id="panel-full-description" aria-labelledby="tab-full-description" class="tab-panel--sinai tab-panel--active">
    <h2 class="overview-heading--sinai">Overview</h2>
    <div class="secondary-metadata_container--sinai">
      <% ms_json_nav = begin JSON.parse(document['manuscript_json_ts'] || '{}') rescue {} end %>
      <% if ms_json_nav['summary'].present? %>
        <!-- DATA SOURCE: ms_obj.summary = <%= ms_json_nav['summary'].to_json %> -->
        <p class="overview-summary--sinai"><%= ms_json_nav['summary'] %></p>
      <% end %>
      <%= render 'catalog/work_record--sinai/item_overview_metadata', document: document %>
      <%= render 'catalog/work_record--sinai/keyword_metadata', document: document %>

      <%# === Parts Section === %>
      <%= render 'catalog/work_record--sinai/parts_metadata', document: document %>

      <%# === Items / Contents Section === %>
      <%= render 'catalog/work_record--sinai/items_metadata', document: document %>

      <%# === Paracontents Section === %>
      <%= render 'catalog/work_record--sinai/paracontents_metadata', document: document %>

      <%# === Notes on the Manuscript Section === %>
      <%= render 'catalog/work_record--sinai/notes_on_manuscript_metadata', document: document %>

      <%# === Full JSON debug viewer === %>
      <details class="overview-json-debug--sinai">
        <summary>View raw manuscript JSON data</summary>
        <pre><%= JSON.pretty_generate(ms_json_nav) %></pre>
      </details>
    </div>
  </div>

  <%# Placeholder tabs %>
  <% tab_definitions.drop(1).each do |tab| %>
    <div role="tabpanel" id="panel-<%= tab[:id] %>" aria-labelledby="tab-<%= tab[:id] %>" class="tab-panel--sinai">
      <% if tab[:id] == 'undertexts' %>
        <%= render 'catalog/work_record--sinai/undertexts_metadata', document: document %>
      <% elsif tab[:id] == 'related-manuscripts' %>
        <%= render 'catalog/work_record--sinai/related_manuscripts_metadata', document: document %>
      <% else %>
        <h2 class="overview-heading--sinai"><%= tab[:label] %></h2>
      <% end %>
    </div>
  <% end %>
</div>
