<div class='item-page__secondary-metadata item-page__secondary-metadata--sinai'>
  <h2 class="overview-heading--sinai">Overview</h2>
  <div class="secondary-metadata_container--sinai">
    <% ms_json_sec = begin JSON.parse(document['manuscript_json_ts'] || '{}') rescue {} end %>
    <% if ms_json_sec['summary'].present? %>
      <!-- DATA SOURCE: ms_obj.summary = <%= ms_json_sec['summary'].to_json %> -->
      <p class="overview-summary--sinai"><%= ms_json_sec['summary'] %></p>
    <% end %>
    <%= render 'catalog/work_record--sinai/item_overview_metadata', document: document %>
    <%= render 'catalog/work_record--sinai/keyword_metadata', document: document %>

    <%# === Full JSON debug viewer === %>
    <details class="overview-json-debug--sinai">
      <summary>View raw manuscript JSON data</summary>
      <pre><%= JSON.pretty_generate(ms_json_sec) %></pre>
    </details>
  </div>
</div>
