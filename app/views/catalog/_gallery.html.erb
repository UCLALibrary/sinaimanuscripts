<% if Flipflop.sinai? %>
<% if counter = document_counter_with_offset(document_counter) %>
<% if !cookies[:sinai_authenticated_1year] %>
    <%= link_to image_tag('sinai/sinai-generic-thumbnail.png'), document, class: 'document__gallery-item-thumbnail-link--sinai' %>
<% else %>
    <%= render_thumbnail_tag(document, {}, class: 'document__gallery-item-thumbnail-link--sinai', counter: counter) %>
<% end %>
<header class="header-gallery--sinai">
    <% if document['shelfmark_ssi'] %>
    <%= link_to document['shelfmark_ssi'], document %>
    <% else %>
    <%= link_to 'Placeholder', document %>
    <% end %>
</header>
<div class="metadata-block-gallery--sinai">
    <div class="metadata-value-gallery--sinai">
        <% gallery_origin_dates = sinai_index_origin_dates(document) %>
        <% if gallery_origin_dates.any? %>
          <%= image_tag('sinai-icons/calendar-icon.png', class: 'icon-calendar-index--sinai') %>
          <%= safe_join(gallery_origin_dates.first(3).map { |d| h(d) }, '&nbsp;|&nbsp;'.html_safe) %><% if gallery_origin_dates.length > 3 %>&nbsp;|&nbsp;...<% end %> &nbsp; | &nbsp;
        <% end %>
        <%= document['extent_tesi'] %>
    </div>
</div>
<% end %>
<% else %>
<% if counter = document_counter_with_offset(document_counter) %>
<%= link_to_document(document, truncate(index_presenter(document).label(document_show_link_field(document)), length: 150, separator: ' '), counter: counter) %>
<% end %>
<% end %>
